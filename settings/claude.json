{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_PLUGIN_DIRS": "{{claude_dir}}/.agent-skills-mods/self-clear",
    "pnpm_config_store_dir": "~/.cache/pnpm/store",
    "XDG_RUNTIME_DIR": "/tmp/claude"
  },
  "fileCheckpointingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(~/Code/**)",
      "Read(~/.config/agent-skills/state.json)",
      "Read({{claude_dir}}/skills/**)",
      "Read({{claude_dir}}/agents/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git rebase:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh search:*)",
      "Bash(task:*)",
      "Bash(mise:*)",
      "Bash(ruff:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(actionlint:*)",
      "Bash(markdownlint-cli2:*)",
      "Bash(yamllint:*)",
      "Bash(hadolint:*)",
      "Bash(kubeconform:*)",
      "Bash(gofmt:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(golangci-lint:*)",
      "Bash(tofu fmt:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu init:*)",
      "Bash(tofu plan:*)",
      "Bash(tflint:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(helm unittest:*)",
      "Bash(helm show:*)",
      "Bash(conftest:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(kubectl config get-contexts:*)",
      "Bash(kubectl config current-context:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release download:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release delete-asset:*)",
      "Bash(gh release upload:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu import:*)",
      "Bash(tofu state:*)",
      "Bash(tofu taint:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm uninstall:*)",
      "Bash(talosctl upgrade:*)",
      "Bash(talosctl apply-config:*)",
      "Bash(brew:*)"
    ],
    "deny": [
      "Bash(terraform:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu output:*)",
      "Bash(tofu console:*)",
      "Bash(tofu show:*)",
      "Bash(tofu state show:*)",
      "Bash(tofu state pull:*)",
      "Bash(bao kv get:*)",
      "Bash(bao read:*)",
      "Bash(vault kv get:*)",
      "Bash(vault read:*)",
      "Bash(bws secret get:*)",
      "Bash(bws secret list:*)",
      "Bash(bw get:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)",
      "Bash(gh auth token:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh label create:*)",
      "Bash(gh label delete:*)",
      "Bash(gh label edit:*)",
      "Bash(gh label clone:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh variable set:*)",
      "Bash(gh variable delete:*)",
      "Bash(gh alias:*)",
      "Bash(gh extension:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo set-default:*)",
      "Bash(talosctl reset:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development*)",
      "Read(**/.env.production*)",
      "Read(**/.env.staging*)",
      "Read(**/.env.test*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/kubeconfig)",
      "Read(**/talosconfig)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/secrets.tfvars)",
      "Read(**/secrets.auto.tfvars)",
      "Read(**/secrets.tfvars.json)",
      "Read(**/secrets.auto.tfvars.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.talos/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/hcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.bao-token)",
      "Read(~/.vault-token)",
      "Read(~/.netrc)",
      "Read(~/.zshrc)",
      "Read(~/.zshenv)",
      "Edit({{claude_dir}}/settings.json)",
      "Edit({{claude_dir}}/CLAUDE.md)",
      "Edit({{claude_dir}}/skills/**)",
      "Edit({{claude_dir}}/agents/**)",
      "Edit({{claude_dir}}/.agent-skills-hooks/**)",
      "Edit(~/.config/agent-skills/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "gh *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git push",
      "git push *",
      "tofu init",
      "tofu init *",
      "tofu validate",
      "tofu validate *",
      "tofu plan",
      "tofu plan *",
      "tofu test",
      "tofu test *",
      "tflint",
      "tflint *",
      "mise install",
      "mise install *",
      "mise ls-remote *",
      "mise outdated",
      "go mod download",
      "go mod download *",
      "go mod tidy",
      "go mod tidy *",
      "go get",
      "go get *"
    ],
    "filesystem": {
      "allowRead": [
        "~/Code",
        "~/.ssh/known_hosts",
        "~/.ssh/known_hosts2"
      ],
      "allowWrite": [
        "/private/var/folders/*/*/T",
        "~/Library/Caches/go-build",
        "~/Library/Caches/golangci-lint",
        "~/Library/Caches/mise",
        "~/Library/Caches/helm",
        "~/Library/helm",
        "~/go/pkg/mod",
        "~/go/pkg/sumdb",
        "~/.cache",
        "~/.terraform.d",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.kube/cache",
        "~/.helm/cache"
      ],
      "denyRead": [
        "~/.zshrc",
        "~/.zshenv",
        "~/.netrc",
        "~/.bao-token",
        "~/.vault-token",
        "~/.config/gh",
        "~/.config/hcloud",
        "~/.docker/config.json",
        "**/.env",
        "**/.env.local",
        "**/.env.*.local",
        "**/.env.development*",
        "**/.env.production*",
        "**/.env.staging*",
        "**/.env.test*",
        "**/*.tfstate",
        "**/*.tfstate.*",
        "**/secrets.tfvars",
        "**/secrets.auto.tfvars",
        "**/secrets.tfvars.json",
        "**/secrets.auto.tfvars.json",
        "**/kubeconfig",
        "**/talosconfig",
        "**/secrets.yaml",
        "**/secrets.yml",
        "**/*.pem",
        "**/*.key"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GH_TOKEN", "mode": "mask", "injectHosts": ["api.github.com"] },
        { "name": "GITHUB_TOKEN", "mode": "mask", "injectHosts": ["api.github.com"] },
        { "name": "HCLOUD_TOKEN", "mode": "mask", "injectHosts": ["api.hetzner.cloud", "api.hetzner.com"] },
        { "name": "CLOUDFLARE_API_TOKEN", "mode": "mask", "injectHosts": ["api.cloudflare.com"] },
        { "name": "BAO_TOKEN", "mode": "deny" },
        { "name": "VAULT_TOKEN", "mode": "deny" },
        { "name": "BWS_ACCESS_TOKEN", "mode": "deny" },
        { "name": "BW_SESSION", "mode": "deny" }
      ],
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.kube", "mode": "deny" },
        { "path": "~/.talos", "mode": "deny" }
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": ["~/.bitwarden-ssh-agent.sock"],
      "allowedDomains": ["*"]
    }
  },
  "autoMode": {
    "environment": ["$defaults"],
    "soft_deny": [
      "$defaults",
      "Never change repository, organisation or label settings with gh or the web API: they are infrastructure as code",
      "Never cut a release with gh release in a repository that has a release tool (release-me or release-please) configured"
    ]
  }
}
