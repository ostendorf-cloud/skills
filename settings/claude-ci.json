{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit --add-label:*)",
      "Bash(gh pr edit --remove-label:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit --add-label:*)",
      "Bash(gh issue edit --remove-label:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(task check)",
      "Bash(task lint:*)",
      "Bash(task test:*)",
      "Bash(task validate:*)",
      "Bash(ruff:*)",
      "Bash(golangci-lint:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(tofu fmt:*)",
      "Bash(tofu validate:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(helm unittest:*)",
      "Bash(conftest:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(gh label:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh auth:*)",
      "Bash(gh alias:*)",
      "Bash(gh extension:*)",
      "Bash(terraform:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu output:*)",
      "Bash(tofu state:*)",
      "Bash(tofu import:*)",
      "Bash(kubectl:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(talosctl:*)",
      "Bash(bao:*)",
      "Bash(vault:*)",
      "Bash(bws:*)",
      "Bash(bw:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/secrets.tfvars)",
      "Read(**/secrets.auto.tfvars)",
      "Read(**/secrets.tfvars.json)",
      "Read(**/secrets.auto.tfvars.json)",
      "Read(**/kubeconfig)",
      "Read(**/talosconfig)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)"
    ]
  }
}
